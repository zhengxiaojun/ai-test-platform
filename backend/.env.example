# Server Configuration
APP_NAME=AI Test Platform
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (默认使用 SQLite，无需额外配置)
# 使用 SQLite (推荐快速开始)
DATABASE_URL=sqlite:///./ai_test_platform.db
# 或使用 PostgreSQL (生产环境推荐)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_test_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (可选)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery (可选)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==========================================
# LLM Configuration - 选择你的AI提供商
# ==========================================

# LLM Provider: openai, gemini, local, custom
LLM_PROVIDER=openai

# Common LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# ==========================================
# Option 1: OpenAI (默认)
# ==========================================
LLM_API_KEY=your-openai-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo-preview
# 其他可选模型: gpt-4, gpt-3.5-turbo, gpt-4o

# ==========================================
# Option 2: Google Gemini
# ==========================================
# 使用Gemini时，请取消下面的注释并注释掉上面的配置
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-pro
# 其他可选模型: gemini-1.5-pro, gemini-1.5-flash

# ==========================================
# Option 3: 本地部署的LLM
# (支持 Ollama, LocalAI, Text Generation WebUI 等)
# ==========================================
# LLM_PROVIDER=local
# LLM_API_KEY=local-key
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=llama2
# Ollama: http://localhost:11434/v1
# LocalAI: http://localhost:8080/v1
# Text Generation WebUI: http://localhost:5000/v1

# ==========================================
# Option 4: 自定义 OpenAI 兼容API
# (支持 Azure OpenAI, OpenRouter, Together AI 等)
# ==========================================
# LLM_PROVIDER=custom
# LLM_API_KEY=your-custom-api-key
# LLM_API_BASE=https://your-custom-endpoint/v1
# LLM_MODEL=your-model-name

# JWT (可使用默认值，生产环境请更改)
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

