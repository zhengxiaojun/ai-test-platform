# Server Configuration
APP_NAME=AI Test Platform
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (默认使用 SQLite，无需额外配置)
# 使用 SQLite (推荐快速开始)
DATABASE_URL=sqlite:///./ai_test_platform.db
# 或使用 PostgreSQL (生产环境推荐)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_test_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (可选)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Celery (可选)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OpenAI Configuration (必须配置)
# 请替换为你的 OpenAI API Key 或兼容的 API Key
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000

# JWT (可使用默认值，生产环境请更改)
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

